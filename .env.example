# Copy to .env and fill in. .env is gitignored; values are never logged or
# serialized into the resolved spec, ledger, or manifest.

# --- Base Sepolia testnet (runtime/base-sepolia.edn) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# 0x-prefixed private key for the deployer account (fund it with testnet ETH).
BASE_SEPOLIA_DEPLOYER_KEY=

# --- Base Sepolia fork rehearsal (runtime/base-sepolia-fork.edn) ---
# Upstream RPC used as the Anvil fork source. Falls back to BASE_SEPOLIA_RPC_URL.
BASE_SEPOLIA_FORK_RPC_URL=

# --- Optional transaction overrides (also settable via CLI flags) ---
# MAX_FEE_PER_GAS_WEI=
# MAX_PRIORITY_FEE_PER_GAS_WEI=
# RECEIPT_TIMEOUT_MS=
