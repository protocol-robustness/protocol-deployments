;; ============================================================================
;; Deployment architecture
;;
;; Declares logical contracts, their scope (:prf / :sew / :shared), the pinned
;; artifact source each deploys from, and a small explicit relationship
;; vocabulary. Repository placement does NOT determine architectural ownership:
;; a contract may be logically :shared even though its Solidity source lives in
;; sew-protocol. This repo never compiles Solidity source — it consumes pinned
;; deployable artifact bundles only.
;; ============================================================================

{:schemaVersion 1

 ;; ============================================================================
 ;; Cross-repo provenance (which version/commit each external input is pinned to)
 ;;
 ;;   SEW deployables        : sew-protocol @ appeal-primitive-v1-2026-10
 ;;                            (package @sew/deployables@0.1.0; bundle manifest records the git sha)
 ;;   PRF deployables        : prf-evm @ @protocol-robustness/prf-evm-deployables@0.2.0
 ;;   Derived canonical roots: agent-c @ commit 6344909c36a2eda4711efa6a4acd310870fe9f41
 ;;                            (scripts/deployment/genesis_roots.clj, PRF_DEPLOY_CHAIN_ID=84532),
 ;;                            templates etc/deployments/prf-base-sepolia/*.edn; re-derive after
 ;;                            owner-approved canonical inputs (P, A0, C0) are supplied.
 ;; ============================================================================

 ;; Named, pinned deployable artifact sources. These are the consumer boundary.
 ;; Each points at a versioned package exposed by an authoritative source repo.
 :artifactSources
 { :sew/deployables
   {:package "@sew/deployables"
    :version "0.1.0"
    :sourceRepo "sew/sew-protocol"
    :kind :npm}

   :prf/deployables
   {:package "@protocol-robustness/prf-evm-deployables"
    :version "0.2.0"
    :sourceRepo "protocol-robustness/prf-evm"
    :kind :npm}}

 ;; Logical contracts. The map key is the logical identity.
 :contracts
 {    :shared/governance-token
   {:scope :shared
    :artifactSource :sew/deployables
    :artifact "SewToken"
    :parameters
    { :name            {:value "Protocol Governance Token" :mutability :immutable}
      :symbol          {:value "PRF"                      :mutability :immutable}
      :initialSupply   {:value 1000000000000000000000000N :mutability :immutable}
      }
    :constructorBindings
    { :name {:parameter :name}
      :symbol {:parameter :symbol}
      :initialOwner {:deployer true}
      :initialSupply {:parameter :initialSupply}}}

   :shared/timelock
   {:scope :shared
    :artifactSource :sew/deployables
    :artifact "TimelockController"
    :parameters
    { :minDelaySec {:value 86400 :mutability :immutable}}
    :constructorBindings
    { :minDelay {:parameter :minDelaySec}
      :proposers {:array []}
      :executors {:array [{:literal "0x0000000000000000000000000000000000000000"}]}
      :admin {:deployer true}}}

   :shared/governor
   {:scope :shared
    :artifactSource :sew/deployables
    :artifact "GovGovernor"
    :relationships {:dependsOn [:shared/timelock]}
    :parameters
    { :votingDelayBlocks  {:value 1     :mutability :immutable}
      :votingPeriodBlocks {:value 50400 :mutability :immutable}
      :proposalThreshold  {:value 50000000000000000000000N
                           :mutability :governed
                           :constraint {:range [0N 100000000000000000000000N]}}
      :quorum             {:value 4000000000000000000000000N
                           :mutability :governed
                           :constraint {:range [0N 5000000000000000000000000N]}}
      }
    :constructorBindings
    { :token {:contractAddress :shared/governance-token}
      :timelock {:contractAddress :shared/timelock}
      :votingDelayBlocks {:parameter :votingDelayBlocks}
      :votingPeriodBlocks {:parameter :votingPeriodBlocks}
      :proposalThresholdTokens {:parameter :proposalThreshold}
      :absoluteQuorumTokens {:parameter :quorum}
      :initialNonCirculatingAddresses {:array []}}}

   :prf/verifier-registry
   {:scope :prf
    :artifactSource :prf/deployables
    :artifact "PrfVerifierRegistry"
    :parameters
    { :entryFee {:value 0N :mutability :governed :constraint {:range [0N 1000000000000000000N]}}
      }
    :constructorBindings
    { :governor_ {:contractAddress :shared/governor}}}

   :prf/allocation-verifier
   {:scope :prf
    :artifactSource :prf/deployables
    :artifact "PrfRealizedAllocationVerifierAdapter"
    :parameters
    { :verifierVersion {:value "v1.0.0" :mutability :immutable}}
    :constructorBindings
    { :sp1Verifier_ {:deployer true}
      :programVKey_ {:literal "0x0097f2d566143b47a25422049354e1610cfebf67594d57d151eb4296a7f44aee"}
      :programElfSha256_ {:literal "0x0dbe4340e3c0cc83f42c162349f64099c92eebec3becbdefb8ccdace3b040890"}
      :statementSchemaVersion_ {:parameter :verifierVersion}
      :publicValuesSchema_ {:literal "v1"}}}

   :prf/statement-admission
   {:scope :prf
    :artifactSource :prf/deployables
    :artifact "PrfStatementAdmission"
    :relationships {:registeredIn [:prf/verifier-registry]}
    :parameters
    { :maxStatementsPerBatch {:value 100N
                              :mutability :governed
                              :constraint {:range [1N 1000N]}}
      }
    :constructorBindings
    { :genesis_ {:deployer true}
      :configurationExecutor_ {:deployer true}
      :verifierRegistry_ {:contractAddress :prf/verifier-registry}
      ;; Derived from the Base Sepolia (84532) initial-configuration candidate:
      ;;   agent-c: PRF_DEPLOY_CHAIN_ID=84532 clojure -M -m scripts.deployment.genesis-roots \
      ;;             initial-configuration etc/deployments/prf-base-sepolia/initial-configuration-package.edn
      ;; "derived-only-not-approved" — re-derive after the owner-approved canonical inputs (P, A0, C0)
      ;; are supplied. Note this local topology binds :genesis_/:configurationExecutor_ to the deployer EOA;
      ;; a qualified successor deploy must deploy the chain-instance genesis + configuration executor.
      :expectedConfigurationRoot_ {:literal "0xecf384cbb32b68256f5de949e7e3bacc1f0e485f5e590cc8adcc5890388aa353"}
      :expectedConfigurationEpoch_ {:literal 0}}}

   :sew/escrow-vault
   {:scope :sew
    :artifactSource :sew/deployables
    :artifact "EscrowVault"
    :relationships {:administeredBy [:shared/timelock]}
    :parameters
    { :interestRateBps         {:value 500N  :mutability :governed :constraint {:range [0N 2000N]}}
      :liquidationThresholdBps {:value 8500N :mutability :governed :constraint {:range [5000N 9500N]}}
      :maxProtocolFeeBps       {:value 200N  :mutability :governed :constraint {:range [0N 500N]}}
      }
    :constructorBindings
    { :escrowFeeBps {:literal 0}
      :feeAddress {:deployer true}
      :moduleManagementAddress {:deployer true}}}

   :sew/decentralized-resolution-module
   {:scope :sew
    :artifactSource :sew/deployables
    :artifact "DecentralizedResolutionModule"
    :relationships {:dependsOn [:prf/allocation-verifier]
                    :uses       [:prf/verifier-registry]}
    :parameters
    { :disputeStake {:value 100000000000000000000N
                     :mutability :governed
                     :constraint {:range [10000000000000000000N 1000000000000000000000N]}}
      }
    :constructorBindings
    { :initialOwner {:deployer true}}}}}
