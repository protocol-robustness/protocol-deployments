node_modules/
dist/
cache/
artifacts/
# The real SEW/PRF exporter bundles under fixtures/packages are tracked (not ignored)
# so that a fresh clone can resolve without re-running the exporters.
!fixtures/packages/**/artifacts/
!fixtures/packages/**/artifacts/**
# src/artifacts is required TypeScript source (bundle consumer, hashing, types), not build output.
!src/artifacts/
!src/artifacts/**
coverage/
lib

# Local deployment records and ledger state are never committed. Use
# `deployments/*` (not `deployments/`) so the README can still be re-included:
# git cannot un-ignore a file inside an ignored directory.
deployments/*
!deployments/README.md

# Local devnet runtime state (Anvil cache + pid) — never the ledger.
.devnet/

# Tooling caches are regenerated locally and never meaningful to share.
.clj-kondo/
.lsp/

# Environment secrets
.env
.env.*
!.env.example

# Logs
*.log

!fixtures/releases/**/artifacts/
!fixtures/releases/**/artifacts/**
