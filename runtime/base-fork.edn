;; ============================================================================
;; Base (mainnet) Anvil fork runtime — exercise the Base deployment config
;; (logical chainId 8453) backed by a local Anvil fork of Base mainnet.
;;
;; Chain identity (in the environment) is unaffected by the runtime origin: the
;; execution environment is still logically "chainId 8453 / :settlement". This
;; file only says HOW that chain is obtained (an Anvil fork at a block).
;;
;; sourceRpcEnv names an env var holding the fork source RPC URL. No secrets
;; are inlined.
;; ============================================================================

{:schemaVersion 1
 :provider :anvil-fork
 :sourceRpcEnv "BASE_MAINNET_RPC_URL"
 :forkBlock 38200000
 :signer {:type :deterministic-local}}
